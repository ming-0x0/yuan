; https://editorconfig.org/

root = true

[*]
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
end_of_line = lf

[{Makefile,go.mod,go.sum,*.go,.gitmodules}]
indent_style = tab
indent_size = 4
end_of_line = lf

[*.md]
indent_size = 4
trim_trailing_whitespace = false
end_of_line = lf

[*.Dockerfile]
indent_size = 4
end_of_line = lf

[*.yml,*.yaml]
indent_size = 2
end_of_line = lf
indent_style = space
